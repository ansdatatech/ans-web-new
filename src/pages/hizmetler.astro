  <!-- AYDINLIK TEMA CTA (Ortak Harekete Geçirici Kutu) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24 relative z-10 mt-12 bg-transparent">
    <div class="max-w-5xl mx-auto rounded-3xl p-10 lg:p-14 text-center shadow-lg relative overflow-hidden bg-blue-600 border border-blue-500">
      <div class="absolute inset-0 z-0 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:20px_20px] opacity-10 pointer-events-none"></div>
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-white/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10">
        <h2 class="text-3xl lg:text-4xl font-extrabold text-white mb-4">
