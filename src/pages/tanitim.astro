<!-- CSS: Tamamen Aydınlık/Açık Renk (Light Theme) Odaklı Değiştirildi -->
<style>
  :root {
    /* Açık Tema Renk Paleti */
    --night: #f8fafc; /* Ana Zemin - Çok açık gri */
    --navy: #ffffff;  /* Kutu ve Section Zeminleri - Beyaz */
    --panel: #ffffff;
    --panel-2: #eff6ff; /* İkon Arka Planları - Açık mavi */
    
    --trace: #e2e8f0; /* Çizgiler ve Borderlar */
    --trace-hi: #cbd5e1; /* Hover Borderlar */
    
    --blue: #2563eb; /* Birincil Butonlar ve Vurgular */
    --sky: #3b82f6;  /* İkonlar ve Siber Devre */
    --ice: #eff6ff;  /* Etiket (Tag) Arka Planı */
    
    --ink: #0f172a;  /* Ana Başlıklar - Koyu Gri/Siyah */
    --sub: #475569;  /* Paragraf Metinleri */
    --faint: #64748b; /* Pasif Metinler ve Tarihler */
    
    --line: rgba(0, 0, 0, 0.08); /* İnce ayrım çizgileri */
    --shadow-soft: 0 10px 30px -10px rgba(0, 0, 0, 0.08); /* Şık kutu gölgeleri */

    --display: "Antonio", "Oswald", "Arial Narrow", sans-serif;
    --sans: "IBM Plex Sans", system-ui, -apple-system, sans-serif;
    --mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
    color-scheme: light;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0; padding: 0;
    background: var(--night);
    color: var(--sub);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; }
  .wrap { max-width: 1120px; margin: 0 auto; padding-inline: 20px; }
  
  .eyebrow {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--blue); font-weight: 600;
  }
  h1, h2, h3 {
    font-family: var(--display); font-weight: 700; letter-spacing: 0.005em;
    text-wrap: balance; margin: 0; color: var(--ink);
  }
  h2 { font-size: clamp(32px, 5vw, 42px); line-height: 1.1; }
  .lead { max-width: 62ch; margin: 0; font-weight: 500; }
  
  section { position: relative; }
  .sec { padding-block: 88px; }
  .sec-head { display: grid; gap: 14px; margin-bottom: 44px; }

  /* Navigasyon */
  .nav {
    position: sticky; top: 0; z-index: 20;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 12px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--display); font-weight: 700; font-size: 22px; white-space: nowrap; color: var(--ink); }
  .brand img { height: 32px; width: auto; }
  .brand span { color: var(--blue); }
  .nav ul { display: flex; gap: 26px; list-style: none; margin: 0; padding: 0; font-size: 14px; font-weight: 600; color: var(--sub); }
  .nav ul a { text-decoration: none; transition: color 0.2s; }
  .nav ul a:hover { color: var(--blue); }
  @media (max-width: 760px) { .nav ul { display: none; } }

  /* Butonlar */
  .btn {
    display: inline-flex; align-items: center; gap: 10px; font: 600 15px var(--sans);
    text-decoration: none; border-radius: 8px; padding: 13px 20px; border: 1px solid transparent;
    cursor: pointer; transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }
  .btn-primary { background: var(--blue); color: #fff; box-shadow: 0 4px 14px 0 rgba(37, 99, 235, 0.39); }
  .btn-primary:hover { background: #1d4ed8; transform: translateY(-1px); }
  .btn-ghost { border-color: var(--trace-hi); color: var(--ink); background: var(--navy); }
  .btn-ghost:hover { border-color: var(--blue); color: var(--blue); }
  .btn-sm { padding: 9px 14px; font-size: 14px; }

  /* Hero */
  .hero {
    overflow: hidden;
    background: radial-gradient(ellipse 70% 60% at 72% 42%, rgba(59, 130, 246, 0.1), transparent 70%), linear-gradient(180deg, var(--night), var(--navy));
    position: relative;
    border-bottom: 1px solid var(--line);
  }
  .circuit { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0.5; }
  .circuit .pulse { stroke: var(--sky); stroke-width: 2; fill: none; stroke-dasharray: 14 900; stroke-linecap: round; animation: run 5.5s linear infinite; }
  @keyframes run { from { stroke-dashoffset: 914; } to { stroke-dashoffset: 0; } }
  .hero .wrap { position: relative; z-index: 1; display: grid; grid-template-columns: 1.15fr 0.85fr; align-items: center; gap: 40px; padding-block: 84px 96px; }
  .hero h1 { font-size: clamp(40px, 6vw, 72px); line-height: 1.05; margin: 18px 0 22px; }
  .hero h1 em { font-style: normal; color: var(--blue); }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .pillars { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 36px 0 0; padding: 0; list-style: none; font-family: var(--sans); font-weight: 600; font-size: 14px; color: var(--ink); }
  .pillars li { display: flex; align-items: center; gap: 8px; }
  .pillars li::before { content: ""; width: 8px; height: 8px; border-radius: 2px; background: var(--blue); }
  
  .owlwrap { position: relative; display: grid; place-items: center; }
  .owlwrap .ring { position: absolute; width: min(420px, 90%); aspect-ratio: 1; border-radius: 50%; border: 1px solid var(--trace-hi); opacity: 0.55; }
  .owlwrap .ring.r2 { width: min(320px, 70%); border-style: dashed; opacity: 0.35; }
  .owlwrap img { position: relative; width: min(240px, 70%); height: auto; box-shadow: var(--shadow-soft); border: 1px solid var(--line); background: white; padding: 1rem; }
  
  @media (max-width: 860px) {
    .hero .wrap { grid-template-columns: 1fr; padding-block: 56px 64px; }
    .owlwrap { order: -1; }
    .owlwrap img { width: min(150px, 40%); }
  }

  /* About Bandı */
  .about { background: var(--navy); border-bottom: 1px solid var(--line); }
  .about .wrap { display: grid; grid-template-columns: auto 1fr; gap: 32px; align-items: start; padding-block: 48px; }
  .about p { margin: 0; font-size: clamp(18px, 2.2vw, 22px); line-height: 1.5; max-width: 60ch; color: var(--ink); }
  .about p b { color: var(--blue); font-weight: 600; }
  @media (max-width: 700px) { .about .wrap { grid-template-columns: 1fr; gap: 12px; } }

  /* Hizmet Kartları */
  .services { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--navy); box-shadow: var(--shadow-soft); }
  .svc { padding: 30px 28px 32px; display: grid; gap: 14px; align-content: start; border-right: 1px solid var(--line); }
  .svc:last-child { border-right: 0; }
  .svc .ico { width: 44px; height: 44px; border-radius: 10px; background: var(--panel-2); border: 1px solid var(--trace); display: grid; place-items: center; }
  .svc .ico svg { width: 24px; height: 24px; }
  .svc h3 { font-size: 24px; line-height: 1.2; color: var(--ink); }
  .svc p { margin: 0; }
  .svc ul { list-style: none; margin: 6px 0 0; padding: 14px 0 0; border-top: 1px dashed var(--trace-hi); display: grid; gap: 6px; font-size: 14px; font-weight: 500; color: var(--ink); }
  .svc ul li { display: flex; gap: 10px; }
  .svc ul li::before { content: "✓"; color: var(--blue); font-weight: 800; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .tags span { font-family: var(--mono); font-size: 11px; font-weight: 600; color: var(--blue); background: var(--ice); border: 1px solid var(--trace-hi); padding: 4px 8px; border-radius: 5px; }
  @media (max-width: 900px) {
    .services { grid-template-columns: 1fr; }
    .svc { border-right: 0; border-bottom: 1px solid var(--line); }
    .svc:last-child { border-bottom: 0; }
  }

  /* Süreç */
  .process { background: var(--night); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; position: relative; }
  .steps::before { content: ""; position: absolute; left: 0; right: 0; top: 22px; height: 2px; background: linear-gradient(90deg, var(--blue), var(--trace)); }
  .steps li { position: relative; display: grid; gap: 10px; align-content: start; }
