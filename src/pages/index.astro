---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="ANS Yazılım & Veri Çözümleri | İşinizi Büyüten Teknoloji">
  
  <!-- GOOGLE SEO SIKÇA SORULAN SORULAR ŞEMASI (JSON-LD) -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [{
        "@type": "Question",
        "name": "Projemizin tamamlanma süreci nasıl ilerliyor?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "İhtiyaçlarınızı analiz ederek başlıyoruz. UX/UI tasarımı, veritabanı mimarisi ve kodlama aşamalarını şeffaf bir takvimle yürütüyor, projenizi tam söz verdiğimiz tarihte teslim ediyoruz."
        }
      },{
        "@type": "Question",
        "name": "İş teslim edildikten sonra teknik destek alabilecek miyiz?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Kesinlikle. Sektördeki en büyük sorunun 'ulaşılamamak' olduğunun farkındayız. Proje tesliminden sonra da periyodik bakım, güvenlik güncellemeleri ve teknik destek için daima bir telefon uzağınızdayız."
        }
      },{
        "@type": "Question",
        "name": "Hazır şablon mu kullanıyorsunuz yoksa projeye özel mi kodluyorsunuz?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Birbirinin kopyası hazır şablonlar kullanmıyoruz. Tüm kurumsal web siteleri ve SaaS uygulamalarını işletmenizin kimliğine ve ihtiyaçlarına özel, yüksek performanslı ve SEO uyumlu modern mimarilerle (Astro, Django) sıfırdan inşa ediyoruz."
        }
      },{
        "@type": "Question",
        "name": "Fiyatlandırma ve bütçeleme nasıl yapılıyor?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ücretsiz ilk görüşmemizde projenizin kapsamını dinliyoruz. Ardından, sürpriz maliyetlerin çıkmayacağı, her kalemin açıkça belirtildiği şeffaf bir proje teklifi ve zaman çizelgesi sunuyoruz."
        }
      }]
    }
  </script>

  <!-- 1. HERO BÖLÜMÜ -->
  <section class="relative max-w-full overflow-hidden pt-32 pb-24 lg:pt-36 bg-transparent border-b border-slate-200">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        
        <div class="text-left space-y-8">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-sm font-bold shadow-sm">
            <span class="flex h-2 w-2 rounded-full bg-blue-600 animate-pulse shadow-[0_0_8px_#2563eb]"></span>
            İşinizi Büyüten Teknoloji
          </div>
          
          <h1 class="text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
            İşinize Özel, <br />
            <span class="text-blue-600">Zamanında Teslim</span> Yazılım Çözümleri.
          </h1>
          
          <p class="text-lg text-slate-600 font-medium leading-relaxed max-w-lg">
            Karmaşık teknik terimleri bir kenara bırakın. Biz, işinizin ihtiyaçlarını anlar, size zaman kazandıran ve müşteri memnuniyetini artıran güvenilir dijital sistemler kurarız.
          </p>

          <ul class="space-y-4 pt-2 pb-4 bg-white/80 backdrop-blur-sm p-6 rounded-2xl border border-slate-100 shadow-sm">
            <li class="flex items-start gap-3">
              <div class="bg-blue-100 p-1.5 rounded-lg mt-0.5">
                <svg class="w-5 h-5 text-blue-700 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <span class="text-slate-700 font-medium"><strong class="text-slate-900">Tam Zamanında Teslimat:</strong> Sürpriz yok, gecikme yok. İşinizi söz verdiğimiz günde teslim ediyoruz.</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="bg-green-100 p-1.5 rounded-lg mt-0.5">
                <svg class="w-5 h-5 text-green-700 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </div>
              <span class="text-slate-700 font-medium"><strong class="text-slate-900">Doğrudan İletişim:</strong> Aradığınızda veya bir sorunuz olduğunda karşınızda daima net bir muhatap bulursunuz.</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="bg-purple-100 p-1.5 rounded-lg mt-0.5">
                <svg class="w-5 h-5 text-purple-700 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
              </div>
              <span class="text-slate-700 font-medium"><strong class="text-slate-900">Kesintisiz Teknik Destek:</strong> İş bitiminde sizi yalnız bırakmıyoruz. Sisteminiz her zaman güvende ve güncel kalır.</span>
            </li>
          </ul>
          
          <div class="flex flex-col sm:flex-row gap-4 pt-2">
            <a href="/iletisim" class="px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold transition-all shadow-md flex items-center justify-center gap-2">
              Bize Ulaşın
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
            <a href="#referanslar" class="px-8 py-4 bg-white hover:bg-slate-50 text-slate-700 rounded-xl font-bold transition-all border border-slate-200 shadow-sm flex items-center justify-center">
              Neler Yaptık?
            </a>
          </div>
        </div>

        <div class="relative hidden lg:block group">
          <div class="absolute -inset-2 bg-gradient-to-tr from-blue-100 to-slate-100 rounded-3xl blur-xl opacity-70 -z-10"></div>
          <div class="relative w-full overflow-hidden rounded-3xl shadow-xl border border-slate-200 bg-white">
            <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" alt="ANS Yazılım Ekibi Toplantı" class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-105" />
            
            <div class="absolute bottom-6 right-6 bg-white/95 backdrop-blur px-4 py-3 rounded-2xl shadow-lg border border-slate-100 flex items-center gap-3">
               <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center text-green-600">
                 <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
               </div>
               <div>
                 <p class="text-xs text-slate-500 font-semibold uppercase">Müşteri Memnuniyeti</p>
                 <p class="text-lg font-bold text-slate-900">%100 Destek</p>
               </div>
            </div>
          </div>
        </div>
        
      </div>
    </div>
  </section>

  <!-- 2. REFERANSLAR -->
  <section id="referanslar" class="bg-transparent py-24 border-b border-slate-200 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-16">
        <span class="text-blue-600 font-bold tracking-wider uppercase text-sm">Gurur Duyduğumuz İşler</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mt-2">Müşterilerimiz İçin Neler Yaptık?</h2>
        <p class="text-slate-600 font-medium mt-4 max-w-2xl mx-auto">Sektörlerinde öncü firmaların dijital dönüşüm süreçlerini başarıyla yönettik.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- Referans 1: Ahalteke -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-200 hover:shadow-lg transition-shadow">
           <img src="/ahal-web.png" class="w-full h-48 object-cover object-top border-b border-slate-100" alt="Ahalteke Turnuva Sistemi" />
           <div class="p-6">
              <span class="inline-block px-3 py-1 bg-blue-50 text-blue-700 text-xs font-bold rounded-full mb-3">Otomasyon & SaaS</span>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Ahalteke Tenis Kulübü</h3>
              <p class="text-slate-600 text-sm mb-4">Kulübün tüm kort rezervasyonlarını, oyuncu takiplerini ve turnuva fikstürlerini tam otomatik hale getiren özel web uygulaması.</p>
              <div class="text-sm font-medium text-slate-800 border-t border-slate-100 pt-4">
                <strong>Fayda:</strong> Telefon trafiği %90 azaldı, rezervasyon hataları sıfırlandı.
              </div>
           </div>
        </div>

        <!-- Referans 2: Manuvital Randevu (YENİ) -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-200 hover:shadow-lg transition-shadow">
           <!-- Eğer randevu sisteminin ayrı bir resmi varsa manuvital-randevu.png olarak değiştirebilirsiniz -->
           <img src="/manuvital-web.png" class="w-full h-48 object-cover object-top border-b border-slate-100" alt="Manuvital Randevu Sistemi" />
           <div class="p-6">
              <span class="inline-block px-3 py-1 bg-green-50 text-green-700 text-xs font-bold rounded-full mb-3">Randevu Otomasyonu</span>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Manuvital Randevu Sistemi</h3>
              <p class="text-slate-600 text-sm mb-4">Danışanların kolayca randevu oluşturabildiği, klinikteki seans takvimini otomatik düzenleyen akıllı rezervasyon modülü.</p>
              <div class="text-sm font-medium text-slate-800 border-t border-slate-100 pt-4">
                <strong>Fayda:</strong> Randevu takibi otomatikleşti, asistan yükü azaldı.
              </div>
           </div>
        </div>

        <!-- Referans 3: Bek Akademi -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-200 hover:shadow-lg transition-shadow">
           <img src="/bek-web.png" class="w-full h-48 object-cover object-top border-b border-slate-100" alt="Bek Akademi" />
           <div class="p-6">
              <span class="inline-block px-3 py-1 bg-purple-50 text-purple-700 text-xs font-bold rounded-full mb-3">Kurumsal Web Sitesi</span>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Bek Eğitim Akademi</h3>
              <p class="text-slate-600 text-sm mb-4">Kurumun vizyonunu ve eğitim kadrosunu yansıtan, velilerle iletişimi güçlendiren şık ve erişilebilir dijital platform.</p>
              <div class="text-sm font-medium text-slate-800 border-t border-slate-100 pt-4">
                <strong>Fayda:</strong> Kurumsal marka imajı güçlendi, kayıt bilgi talepleri dijitalleşti.
              </div>
           </div>
        </div>

      </div>
      
      <div class="text-center mt-12">
        <a href="/projeler" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-blue-600 border border-blue-200 rounded-xl font-bold hover:bg-blue-50 transition-colors shadow-sm">
          Tüm Projelerimizi Görün
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
      </div>

    </div>
  </section>

<!-- 3. HİZMETLER VE KURUMSAL GÜVEN -->
  <section class="bg-transparent py-24 relative z-10 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        
        <!-- Sol Taraf -->
        <div class="space-y-6 order-2 lg:order-1 bg-white/80 backdrop-blur-sm p-8 rounded-3xl border border-slate-100 shadow-sm">
          <span class="text-blue-600 font-bold tracking-wider uppercase text-sm">Hizmetlerimiz</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 leading-tight">
            17 Yıllık Tecrübe ile <br/>
            Kalıcı ve Sorunsuz Sistemler.
          </h2>
          
          <div class="space-y-4 text-slate-600 font-medium leading-relaxed">
            <p>
              ANS Yazılım & Veri Çözümleri olarak, işletmenizin sadece bugününü değil, yarınını da düşünerek altyapılar kuruyoruz. Birbirinin kopyası hazır şablonlar kullanmıyoruz.
            </p>
            <p>
              İster markanızı en iyi şekilde yansıtacak bir <strong>Kurumsal Web Sitesi</strong>, ister personel ve müşteri trafiğinizi yönetecek <strong>Özel bir Randevu/Müşteri Sistemi</strong> olsun; yüksek güvenlikli ve kolay kullanımlı çözümler üretiyoruz.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
             <div class="bg-white p-4 rounded-xl border border-slate-200 flex items-center gap-3 shadow-sm">
                <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
                <span class="font-bold text-slate-800">Kurumsal Web Siteleri</span>
             </div>
             <div class="bg-white p-4 rounded-xl border border-slate-200 flex items-center gap-3 shadow-sm">
                <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                <span class="font-bold text-slate-800">Sistem ve Otomasyon</span>
             </div>
             <div class="bg-white p-4 rounded-xl border border-slate-200 flex items-center gap-3 shadow-sm">
                <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                <span class="font-bold text-slate-800">Veri Analizi ve Raporlama</span>
             </div>
             <!-- Değişen 4. Madde (Sağ taraftaki detay listesiyle uyumlu olması için Hız yerine SEO yazıldı) -->
             <div class="bg-white p-4 rounded-xl border border-slate-200 flex items-center gap-3 shadow-sm">
                <svg class="w-8 h-8 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                <span class="font-bold text-slate-800">SEO & Görünürlük</span>
             </div>
          </div>
        </div>

        <!-- Sağ Taraf: İkili İkon, Detaylı Güvenlik, Performans ve SEO Kartı -->
        <div class="order-1 lg:order-2 relative bg-white rounded-3xl p-8 lg:p-10 border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-center h-full">
           
           <div class="absolute top-0 right-0 -mt-16 -mr-16 w-64 h-64 bg-gradient-to-br from-blue-100 to-blue-50 rounded-full blur-3xl opacity-70 -z-10"></div>
           
           <!-- Üst Başlık ve İkili İkon (Kilit + Yıldırım) -->
           <div class="flex items-center gap-4 mb-8 border-b border-slate-100 pb-6">
             <div class="flex -space-x-4">
               <div class="w-14 h-14 bg-blue-50 border border-blue-100 rounded-2xl flex items-center justify-center shadow-inner relative z-10">
                  <svg class="w-7 h-7 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
               </div>
               <div class="w-14 h-14 bg-orange-50 border border-orange-100 rounded-2xl flex items-center justify-center shadow-inner relative z-0">
                  <svg class="w-7 h-7 text-orange-500 pl-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
               </div>
             </div>
             <div>
               <h3 class="text-2xl font-bold text-slate-900">Güçlü Altyapı</h3>
               <p class="text-slate-500 text-sm font-medium">Güvenlik, Hız ve Görünürlük.</p>
             </div>
           </div>
           
           <!-- Detaylı Özellik Listesi -->
           <div class="space-y-6">
           
              <!-- Madde 1 -->
              <div class="flex items-start gap-4 group">
                 <div class="bg-blue-50 p-2.5 rounded-xl text-blue-600 mt-0.5 border border-blue-100 group-hover:bg-blue-600 group-hover:text-white transition-colors shadow-sm flex-shrink-0">
                   <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                 </div>
                 <div>
                   <h4 class="text-slate-900 font-bold text-lg">Milisaniyelik Yanıt Süresi</h4>
                   <p class="text-slate-600 text-sm mt-1 leading-relaxed">Siteniz ve uygulamalarınız modern altyapı sayesinde anında yüklenir, bekleme süresi yüzünden müşteri kaybı yaşatmaz.</p>
                 </div>
              </div>
           
           
              <!-- Madde 2 -->
              <div class="flex items-start gap-4 group">
                 <div class="bg-green-50 p-2.5 rounded-xl text-green-600 mt-0.5 border border-green-100 group-hover:bg-green-600 group-hover:text-white transition-colors shadow-sm flex-shrink-0">
                   <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                 </div>
                 <div>
                   <h4 class="text-slate-900 font-bold text-lg">KVKK & Veri Şifreleme</h4>
                   <p class="text-slate-600 text-sm mt-1 leading-relaxed">Müşteri verileriniz uluslararası standartlarda şifrelenir, KVKK yönergelerine tam uyum sağlanır.</p>
                 </div>
              </div>

              <!-- Madde 3: YENİ SEO BÖLÜMÜ -->
              <div class="flex items-start gap-4 group">
                 <div class="bg-orange-50 p-2.5 rounded-xl text-orange-500 mt-0.5 border border-orange-100 group-hover:bg-orange-500 group-hover:text-white transition-colors shadow-sm flex-shrink-0">
                   <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                 </div>
                 <div>
                   <h4 class="text-slate-900 font-bold text-lg">Google SEO Görünürlüğü</h4>
                   <p class="text-slate-600 text-sm mt-1 leading-relaxed">Siteniz arama motorlarının tam istediği teknik mimariyle kodlanır. Organik olarak üst sıralara çıkarak marka bilinirliğinizi artırırsınız.</p>
                 </div>
              </div>
           </div>

        </div>

      </div>
    </div>
  </section>
  <!-- 4. SIKÇA SORULAN SORULAR -->
  <section class="bg-transparent py-24 relative z-10 border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-12">
        <span class="text-blue-600 font-bold tracking-wider uppercase text-sm">Aklınızdaki Sorular</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mt-2">Sıkça Sorulan Sorular</h2>
        <p class="text-slate-600 font-medium mt-4">İş birliğimiz öncesi en çok merak edilen konuları şeffaflıkla yanıtlıyoruz.</p>
      </div>

      <div class="space-y-4">
        
        <details class="group bg-white border border-slate-200 rounded-2xl shadow-sm [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between p-6 cursor-pointer font-bold text-slate-900 group-open:text-blue-600 transition-colors">
